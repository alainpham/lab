#!/bin/bash
# gentls - Generate self-signed TLS certificates trusted by browsers
#
# Usage:
#   gentls               - generate wildcard certs for WILDCARD_DOMAIN,
#                          K3S_WILDCARD_DOMAIN and EXTRA_WILDCARD_DOMAINS
#   gentls domain [...]  - generate cert for custom domain(s)
#   gentls --force       - as above, but reissue certs even if still valid
#                          (combines with a domain list; never touches the CA)
#   gentls --ca-only     - generate/renew the CA only
#   gentls --status        - show the CA, issued certs and where the CA is trusted
#   gentls --install-ca    - install CA into system trust store (requires sudo)
#   gentls --uninstall-ca  - remove CA from system trust store (requires sudo)
#
# --status exits 0 when everything matches, 1 when something needs attention.


set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -z "${DATA_ROOT_FOLDER:-}" ]; then
  source "${SCRIPT_DIR}/initlab"
fi

TLS_DIR="${DATA_ROOT_FOLDER}/tls"
CA_DIR="${TLS_DIR}/ca"
LIVE_DIR="${TLS_DIR}/cfg/live"
CA_KEY="${CA_DIR}/ca.key"
CA_CERT="${CA_DIR}/ca.crt"
CA_SUBJECT="/C=FR/ST=Local/L=Local/O=LocalLab/CN=LocalLab-CA"
CA_CN="${CA_SUBJECT##*/CN=}"   # used to find the CA in NSS databases
CERT_VALIDITY_DAYS=825   # max accepted by modern browsers (< 398 for strict)
CA_VALIDITY_DAYS=3650

# Wildcard domains a bare 'gentls' always issues, on top of WILDCARD_DOMAIN and
# K3S_WILDCARD_DOMAIN which come from initlab. Each entry yields one cert
# covering both the apex and *.apex. Add more here as needed.
EXTRA_WILDCARD_DOMAINS=("codersandbox.com")

# A certificate with less than this many days left is reissued rather than kept
RENEW_BEFORE_DAYS=30

# Set by --force: reissue leaf certificates even when the existing ones are
# still valid. Never touches the CA - replacing that would invalidate every
# trust store install, so it stays behind --ca-only.
FORCE=0

mkdir -p "${CA_DIR}" "${LIVE_DIR}"

# ── helpers ──────────────────────────────────────────────────────────────────

# Locate a command that may live in sbin (not on a normal user PATH)
find_cmd() {
  local c
  for c in "$1" "/usr/sbin/$1" "/sbin/$1" "/usr/local/sbin/$1"; do
    command -v "${c}" >/dev/null 2>&1 && { command -v "${c}"; return 0; }
  done
  return 1
}

# Distros disagree on both the drop-in directory and the refresh command.
#   Debian/Ubuntu : /usr/local/share/ca-certificates  + update-ca-certificates
#   openSUSE/SLE  : /etc/pki/trust/anchors            + update-ca-certificates (p11-kit)
#   Fedora/RHEL   : /etc/pki/ca-trust/source/anchors  + update-ca-trust
#   Arch          : /etc/ca-certificates/trust-source/anchors + trust extract-compat
# Sets: TRUST_ANCHOR_DIR, TRUST_UPDATE_CMD, TRUST_FLAVOUR
detect_trust_store() {
  local dir cmd path
  for entry in \
    "/usr/local/share/ca-certificates:update-ca-certificates:debian" \
    "/etc/pki/trust/anchors:update-ca-certificates:suse" \
    "/etc/pki/ca-trust/source/anchors:update-ca-trust:fedora" \
    "/etc/ca-certificates/trust-source/anchors:trust:arch" \
  ; do
    dir="${entry%%:*}"
    cmd="${entry#*:}"; cmd="${cmd%%:*}"
    [ -d "${dir}" ] || continue
    path=$(find_cmd "${cmd}") || continue
    TRUST_ANCHOR_DIR="${dir}"
    TRUST_UPDATE_CMD="${path}"
    TRUST_FLAVOUR="${entry##*:}"
    return 0
  done

  echo "ERROR: could not detect this system's CA trust store." >&2
  echo "       Looked for the drop-in dirs of Debian/Ubuntu, openSUSE, Fedora and Arch." >&2
  echo "       Install your distro's 'ca-certificates' package, or import ${CA_CERT} manually." >&2
  return 1
}

# Refresh the system trust store; pass --fresh to rebuild from scratch
refresh_trust_store() {
  case "${TRUST_FLAVOUR}" in
    debian|suse) sudo "${TRUST_UPDATE_CMD}" "$@" ;;
    fedora)      sudo "${TRUST_UPDATE_CMD}" extract ;;
    arch)        sudo "${TRUST_UPDATE_CMD}" extract-compat ;;
  esac
}

# certutil ships separately (libnss3-tools on Debian, mozilla-nss-tools on SUSE,
# nss-tools on Fedora, nss on Arch). The system trust store step still works
# without it, so warn instead of aborting.
require_certutil() {
  command -v certutil >/dev/null 2>&1 && return 0
  echo ""
  echo "WARNING: 'certutil' not found - skipping the Chrome/Firefox NSS steps."
  echo "         The system trust store (curl, k8s tooling, ...) was still updated."
  echo "         Install it with one of:"
  echo "           openSUSE : sudo zypper install mozilla-nss-tools"
  echo "           Debian   : sudo apt install libnss3-tools"
  echo "           Fedora   : sudo dnf install nss-tools"
  echo "           Arch     : sudo pacman -S nss"
  echo "         then re-run: gentls ${1:---install-ca}"
  return 1
}

# Chromium-family NSS databases.
# Flatpak browsers with the 'home' permission see the real $HOME and therefore
# use the host ~/.pki/nssdb. Ones confined to their own sandbox get a private
# ~/.var/app/<id>/.pki/nssdb instead, so cover both.
chromium_nss_dbs() {
  local d
  for d in \
    "${HOME}/.pki/nssdb" \
    "${HOME}/.var/app"/*/.pki/nssdb \
    "${HOME}/snap"/*/current/.pki/nssdb \
  ; do
    [ -d "${d}" ] && echo "${d}"
  done
  return 0
}

# Firefox profile directories, across native / flatpak / snap layouts.
# A directory counts as a profile if it already has a cert9.db, or if it looks
# like one (times.json / prefs.js) - certutil -A creates the db when missing.
# Matching on content rather than a '*.default*' name also catches custom names.
firefox_nss_dbs() {
  local root profile
  for root in \
    "${HOME}/.mozilla/firefox" \
    "${HOME}/snap/firefox/common/.mozilla/firefox" \
    "${HOME}/.var/app/org.mozilla.firefox/.mozilla/firefox" \
    "${HOME}/.var/app/org.mozilla.firefox/config/mozilla/firefox" \
  ; do
    [ -d "${root}" ] || continue
    for profile in "${root}"/*/; do
      if [ -f "${profile}cert9.db" ] || [ -f "${profile}prefs.js" ] || [ -f "${profile}times.json" ]; then
        echo "${profile%/}"
      fi
    done
  done
  return 0
}

# Remove every trace of our CA from one NSS database.
# Two things make a single 'certutil -D -n LocalLab-CA' insufficient:
#   1. NSS allows several certificates to share a nickname (one per CA
#      generation), and -D removes only the first match - so loop.
#   2. A CA imported by hand through the Firefox UI lands under a different
#      nickname, so also sweep for any cert whose subject is our CA.
# Echoes the number of certificates removed.
nss_purge_ca() {
  local db="$1" removed=0 nick
  while certutil -D -n 'LocalLab-CA' -d "sql:${db}" -f /dev/null 2>/dev/null; do
    removed=$((removed + 1))
  done
  while IFS= read -r nick; do
    [ -n "${nick}" ] || continue
    certutil -L -n "${nick}" -d "sql:${db}" 2>/dev/null \
      | grep -q "CN=${CA_CN}" || continue
    while certutil -D -n "${nick}" -d "sql:${db}" -f /dev/null 2>/dev/null; do
      removed=$((removed + 1))
    done
  done < <(certutil -L -d "sql:${db}" 2>/dev/null \
             | tail -n +4 \
             | sed 's/[[:space:]]\{2,\}[^[:space:]]*[[:space:]]*$//' \
             | sed '/^$/d')
  echo "${removed}"
}

# ── status helpers ───────────────────────────────────────────────────────────

# SHA-256 fingerprint of a PEM certificate, colons stripped, for comparison.
cert_fingerprint() {
  openssl x509 -noout -fingerprint -sha256 -in "$1" 2>/dev/null \
    | sed 's/.*=//' | tr -d ':'
}

# Whole days until a certificate expires (negative once expired).
cert_days_left() {
  local end epoch now
  end=$(openssl x509 -noout -enddate -in "$1" 2>/dev/null | sed 's/notAfter=//') || return 1
  [ -n "${end}" ] || return 1
  epoch=$(date -d "${end}" +%s 2>/dev/null) || return 1
  now=$(date +%s)
  echo $(( (epoch - now) / 86400 ))
}

# Fingerprints of every certificate in an NSS database whose subject is our CA.
# One line per certificate, so a database holding several CA generations shows
# each of them rather than collapsing to one.
nss_ca_fingerprints() {
  local db="$1" nick
  while IFS= read -r nick; do
    [ -n "${nick}" ] || continue
    certutil -L -n "${nick}" -d "sql:${db}" 2>/dev/null \
      | grep -q "CN=${CA_CN}" || continue
    certutil -L -n "${nick}" -d "sql:${db}" -a 2>/dev/null \
      | openssl x509 -noout -fingerprint -sha256 2>/dev/null \
      | sed 's/.*=//' | tr -d ':'
  done < <(certutil -L -d "sql:${db}" 2>/dev/null \
             | tail -n +4 \
             | sed 's/[[:space:]]\{2,\}[^[:space:]]*[[:space:]]*$//' \
             | sed '/^$/d')
  return 0
}

# Compare a store's copy of the CA against the CA on disk. Prints one of:
#   OK      same certificate
#   STALE   a different CA generation is trusted
#   MISSING nothing installed here
#   ORPHAN  something is installed but there is no local CA to compare it to
trust_state() {
  local found="$1" want="$2"
  if [ -z "${found}" ]; then
    echo "MISSING"
  elif [ -z "${want}" ]; then
    echo "ORPHAN"
  elif [ "${found}" = "${want}" ]; then
    echo "OK"
  else
    echo "STALE"
  fi
}

warn_if_browser_running() {
  local proc
  for proc in firefox chrome chromium; do
    if pgrep -x "${proc}" >/dev/null 2>&1; then
      echo ""
      echo "NOTE: '${proc}' is running. It may overwrite the certificate database"
      echo "      on exit - close it and re-run if the CA does not take effect."
    fi
  done
}

print_ca_import_instructions() {
  echo ""
  echo "┌─ How to trust the CA ──────────────────────────────────────────────┐"
  echo "│"
  echo "│  System-wide (Chrome, curl, most tools inherit this):              │"
  echo "│    gentls --install-ca                                             │"
  echo "│    (copies ca.crt into your distro's CA anchor dir and refreshes   │"
  echo "│     the trust store)                                               │"
  echo "│"
  echo "│  Firefox (manages its own trust store):                            │"
  echo "│    gentls --firefox                                                │"
  echo "│    — or manually:                                                  │"
  echo "│    Settings > Privacy & Security > Certificates > View Certificates│"
  echo "│    > Authorities tab > Import > select: ${CA_CERT}      │"
  echo "│    Check 'Trust this CA to identify websites'                      │"
  echo "│"
  echo "│  CA certificate path: ${CA_CERT}             │"
  echo "└────────────────────────────────────────────────────────────────────┘"
  echo ""
}

generate_ca() {
  echo ">> Generating local CA key and certificate..."
  openssl genrsa -out "${CA_KEY}" 4096 2>/dev/null
  openssl req -new -x509 \
    -days "${CA_VALIDITY_DAYS}" \
    -key "${CA_KEY}" \
    -out "${CA_CERT}" \
    -subj "${CA_SUBJECT}" \
    -extensions v3_ca \
    -addext "basicConstraints=critical,CA:TRUE" \
    -addext "keyUsage=critical,keyCertSign,cRLSign" \
    -addext "subjectKeyIdentifier=hash"
  echo "   CA key:  ${CA_KEY}"
  echo "   CA cert: ${CA_CERT}"
  print_ca_import_instructions
}

# Is the certificate in this directory still good for exactly these names?
# Every condition has to hold, otherwise the cert gets reissued:
#   - all four output files present
#   - chains to the CA that is on disk *now* (a CA regen invalidates old leaves)
#   - the private key actually belongs to the certificate
#   - SANs match the requested names exactly, so adding or removing a domain
#     from EXTRA_WILDCARD_DOMAINS still triggers a reissue
#   - more than RENEW_BEFORE_DAYS of validity left
cert_is_current() {
  local cert_dir="$1"; shift
  local domains=("$@")
  local cert="${cert_dir}/cert.pem"
  local want have days

  [ -f "${cert}" ] \
    && [ -f "${cert_dir}/privkey.pem" ] \
    && [ -f "${cert_dir}/chain.pem" ] \
    && [ -f "${cert_dir}/fullchain.pem" ] || return 1

  openssl verify -CAfile "${CA_CERT}" "${cert}" >/dev/null 2>&1 || return 1

  [ "$(openssl x509 -noout -pubkey -in "${cert}" 2>/dev/null | sha256sum)" \
    = "$(openssl pkey -in "${cert_dir}/privkey.pem" -pubout 2>/dev/null | sha256sum)" ] || return 1

  want=$(printf 'DNS:%s\n' "${domains[@]}" | sort -u | paste -sd, -)
  have=$(openssl x509 -noout -ext subjectAltName -in "${cert}" 2>/dev/null \
           | tail -n +2 | tr -d ' ' | tr ',' '\n' | sed '/^$/d' | sort -u | paste -sd, -)
  [ "${want}" = "${have}" ] || return 1

  days=$(cert_days_left "${cert}") || return 1
  [ "${days}" -ge "${RENEW_BEFORE_DAYS}" ] || return 1

  return 0
}

generate_cert() {
  local domains=("$@")
  local primary="${domains[0]}"

  # Strip leading wildcard star to get the directory name
  local dir_name
  dir_name=$(echo "${primary}" | sed 's/^\*\.//')

  local cert_dir="${LIVE_DIR}/${dir_name}"

  # Reuse a still-valid certificate so repeated runs are a no-op. Reissuing
  # would hand out a new key and serial, and anything already serving the old
  # files (Traefik) would need a reload to notice.
  if [ "${FORCE}" -eq 0 ] && cert_is_current "${cert_dir}" "${domains[@]}"; then
    echo ">> Keeping certificate for: ${domains[*]}"
    echo "   Dir:         ${cert_dir}"
    echo "   Valid for:   $(cert_days_left "${cert_dir}/cert.pem") more days (use --force to reissue)"
    echo ""
    return 0
  fi

  local key_file="${cert_dir}/privkey.pem"
  local csr_file="${cert_dir}/cert.csr"
  local crt_file="${cert_dir}/cert.pem"
  local chain_file="${cert_dir}/chain.pem"
  local fullchain_file="${cert_dir}/fullchain.pem"
  local ext_file="${cert_dir}/ext.cnf"

  rm -rf "${cert_dir}"
  mkdir -p "${cert_dir}"

  echo ">> Generating certificate for: ${domains[*]}"

  # Build SAN list
  local san=""
  for d in "${domains[@]}"; do
    san="${san:+${san},}DNS:${d}"
  done

  # Extension file (v3 extensions needed for browser trust)
  cat > "${ext_file}" <<EOF
authorityKeyIdentifier = keyid,issuer
basicConstraints       = CA:FALSE
keyUsage               = critical,digitalSignature,keyEncipherment
extendedKeyUsage       = serverAuth
subjectAltName         = ${san}
EOF

  openssl genrsa -out "${key_file}" 2048 2>/dev/null

  openssl req -new \
    -key "${key_file}" \
    -out "${csr_file}" \
    -subj "/C=FR/ST=Local/L=Local/O=LocalLab/CN=${primary}"

  openssl x509 -req \
    -days "${CERT_VALIDITY_DAYS}" \
    -in "${csr_file}" \
    -CA "${CA_CERT}" \
    -CAkey "${CA_KEY}" \
    -CAcreateserial \
    -out "${crt_file}" \
    -extfile "${ext_file}" 2>/dev/null

  # chain = CA cert, fullchain = cert + CA cert (same layout as certbot)
  cp "${CA_CERT}" "${chain_file}"
  cat "${crt_file}" "${CA_CERT}" > "${fullchain_file}"

  rm -f "${csr_file}" "${ext_file}"

  echo "   Dir:       ${cert_dir}"
  echo "   privkey:   ${key_file}"
  echo "   cert:      ${crt_file}"
  echo "   chain:     ${chain_file}"
  echo "   fullchain: ${fullchain_file}"

  # Quick verify
  local not_after
  not_after=$(openssl x509 -noout -enddate -in "${crt_file}" | sed 's/notAfter=//')
  echo "   SANs:      ${san}"
  echo "   Valid until: ${not_after}"
  echo ""
}

# ── main ─────────────────────────────────────────────────────────────────────

# Pull --force out of the arguments wherever it appears, so it composes with a
# bare run and with an explicit domain list alike.
gentls_args=()
for arg in "$@"; do
  case "${arg}" in
    --force|-f) FORCE=1 ;;
    *)          gentls_args+=("${arg}") ;;
  esac
done
set -- ${gentls_args[@]+"${gentls_args[@]}"}

case "${1:-}" in

  --status)
    problems=0

    # ── the CA itself ────────────────────────────────────────────────────────
    echo "CA"
    if [ ! -f "${CA_CERT}" ]; then
      echo "   (none)   no CA at ${CA_CERT} - run 'gentls' to create one"
      problems=1
      ca_fp=""
    else
      ca_fp=$(cert_fingerprint "${CA_CERT}")
      ca_days=$(cert_days_left "${CA_CERT}" || echo "?")
      printf "   %-12s %s\n" "path" "${CA_CERT}"
      printf "   %-12s %s\n" "subject" \
        "$(openssl x509 -noout -subject -in "${CA_CERT}" 2>/dev/null | sed 's/^subject=//')"
      printf "   %-12s %s\n" "sha256" "${ca_fp:0:32}..."
      if [ "${ca_days}" != "?" ] && [ "${ca_days}" -lt 0 ]; then
        printf "   %-12s %s (EXPIRED)\n" "expires" \
          "$(openssl x509 -noout -enddate -in "${CA_CERT}" | sed 's/notAfter=//')"
        problems=1
      else
        printf "   %-12s %s (%s days left)\n" "expires" \
          "$(openssl x509 -noout -enddate -in "${CA_CERT}" | sed 's/notAfter=//')" "${ca_days}"
      fi
      [ -f "${CA_KEY}" ] || { echo "   WARNING  CA key missing - cannot issue new certificates"; problems=1; }
    fi

    # ── issued certificates ──────────────────────────────────────────────────
    echo ""
    echo "Certificates (${LIVE_DIR})"
    cert_count=0
    for cert_dir in "${LIVE_DIR}"/*/; do
      [ -f "${cert_dir}cert.pem" ] || continue
      cert_count=$((cert_count + 1))
      name=$(basename "${cert_dir}")
      days=$(cert_days_left "${cert_dir}cert.pem" || echo "?")
      sans=$(openssl x509 -noout -ext subjectAltName -in "${cert_dir}cert.pem" 2>/dev/null \
               | tail -n +2 | tr -d ' ' | paste -sd, - )
      # Was this leaf signed by the CA currently on disk? After a CA regen the
      # old leaves stop chaining, which browsers report as an untrusted cert.
      if [ -n "${ca_fp}" ] && openssl verify -CAfile "${CA_CERT}" "${cert_dir}cert.pem" >/dev/null 2>&1; then
        chain="chains to current CA"
      else
        chain="DOES NOT CHAIN to current CA - regenerate"
        problems=1
      fi
      if [ "${days}" != "?" ] && [ "${days}" -lt 0 ]; then
        printf "   %-22s EXPIRED    %s\n" "${name}" "${chain}"
        problems=1
      else
        printf "   %-22s %4sd left  %s\n" "${name}" "${days}" "${chain}"
      fi
      printf "   %-22s %s\n" "" "${sans}"
    done
    [ "${cert_count}" -gt 0 ] || echo "   (none)"

    # ── trust stores ─────────────────────────────────────────────────────────
    echo ""
    echo "Trust stores"

    # System: report every anchor dir that holds a copy, not just this
    # distro's, so leftovers from another layout are visible.
    sys_found=0
    for dir in \
      /usr/local/share/ca-certificates \
      /etc/pki/trust/anchors \
      /etc/pki/ca-trust/source/anchors \
      /etc/ca-certificates/trust-source/anchors \
    ; do
      [ -f "${dir}/locallab-ca.crt" ] || continue
      sys_found=1
      state=$(trust_state "$(cert_fingerprint "${dir}/locallab-ca.crt")" "${ca_fp}")
      printf "   %-8s %-7s %s\n" "system" "${state}" "${dir}/locallab-ca.crt"
      [ "${state}" = "OK" ] || problems=1
    done
    if [ "${sys_found}" -eq 0 ]; then
      printf "   %-8s %-7s %s\n" "system" "MISSING" "not in any known anchor dir - run 'gentls --install-ca'"
      problems=1
    fi
    # Functional check: does the default store actually accept the CA? This is
    # what curl / kubectl / openssl really consult.
    if [ -n "${ca_fp}" ]; then
      if openssl verify "${CA_CERT}" >/dev/null 2>&1; then
        printf "   %-8s %-7s %s\n" "" "OK" "openssl trusts it via the default store"
      else
        printf "   %-8s %-7s %s\n" "" "NO" "openssl does NOT trust it (trust store not refreshed?)"
        problems=1
      fi
    fi

    if ! command -v certutil >/dev/null 2>&1; then
      printf "   %-8s %-7s %s\n" "browsers" "SKIP" "certutil not installed - cannot inspect NSS databases"
    else
      for label in chrome firefox; do
        [ "${label}" = "chrome" ] && dbs=$(chromium_nss_dbs) || dbs=$(firefox_nss_dbs)
        if [ -z "${dbs}" ]; then
          printf "   %-8s %-7s %s\n" "${label}" "-" "no database found"
          continue
        fi
        while IFS= read -r db; do
          [ -n "${db}" ] || continue
          fps=$(nss_ca_fingerprints "${db}")
          n=$(printf '%s\n' "${fps}" | sed '/^$/d' | wc -l)
          if [ "${n}" -gt 1 ]; then
            # Several generations of the CA trusted at once - browsers may pin
            # the wrong one. --install-ca now purges before adding.
            printf "   %-8s %-7s %s\n" "${label}" "DUPES" "${n} copies in ${db}"
            problems=1
          else
            state=$(trust_state "$(printf '%s' "${fps}" | head -1)" "${ca_fp}")
            printf "   %-8s %-7s %s\n" "${label}" "${state}" "${db}"
            [ "${state}" = "OK" ] || problems=1
          fi
        done <<< "${dbs}"
      done
    fi

    echo ""
    if [ "${problems}" -eq 0 ]; then
      echo "All good."
    else
      echo "Legend: OK = matches the CA on disk | STALE  = a different CA generation"
      echo "        MISSING = not installed     | DUPES  = several generations trusted"
      echo "        ORPHAN = installed, but there is no local CA to compare against"
      echo "Run 'gentls --install-ca' to (re)install the current CA everywhere."
    fi
    exit "${problems}"
    ;;

  --uninstall-ca)
    detect_trust_store
    # Sweep every known anchor dir, not just this distro's - covers a machine
    # that was installed into under a different layout (or an older gentls).
    echo ">> Removing CA from system trust store..."
    for dir in \
      /usr/local/share/ca-certificates \
      /etc/pki/trust/anchors \
      /etc/pki/ca-trust/source/anchors \
      /etc/ca-certificates/trust-source/anchors \
    ; do
      [ -f "${dir}/locallab-ca.crt" ] || continue
      sudo rm -f "${dir}/locallab-ca.crt"
      echo "   Removed: ${dir}/locallab-ca.crt"
    done
    refresh_trust_store --fresh

    require_certutil || exit 0

    echo ">> Removing CA from Chromium NSS databases..."
    found=0
    while read -r db; do
      [ -n "${db}" ] || continue
      found=1
      n=$(nss_purge_ca "${db}")
      [ "${n}" -gt 0 ] \
        && echo "   Removed ${n} entry/entries from: ${db}" \
        || echo "   Not present in: ${db}"
    done < <(chromium_nss_dbs)
    [ "${found}" -eq 1 ] || echo "   No Chromium NSS database found, skipping."

    echo ">> Removing CA from Firefox NSS databases..."
    found=0
    while read -r db; do
      [ -n "${db}" ] || continue
      found=1
      n=$(nss_purge_ca "${db}")
      [ "${n}" -gt 0 ] \
        && echo "   Removed ${n} entry/entries from: ${db}" \
        || echo "   Not present in: ${db}"
    done < <(firefox_nss_dbs)
    [ "${found}" -eq 1 ] || echo "   No Firefox profile found, skipping."

    warn_if_browser_running
    echo "Done. Restart Chrome and Firefox to apply."
    ;;

  --install-ca)
    if [ ! -f "${CA_CERT}" ]; then
      echo "No CA found. Run 'gentls' first to generate it."
      exit 1
    fi

    detect_trust_store
    echo ">> Installing CA into system trust store (${TRUST_ANCHOR_DIR})..."
    sudo install -m 0644 "${CA_CERT}" "${TRUST_ANCHOR_DIR}/locallab-ca.crt"
    refresh_trust_store

    require_certutil || exit 0

    echo ">> Installing CA into Chromium NSS databases..."
    # Create the default db if absent. Never wipe an existing one - it can hold
    # client certificates the user cannot regenerate.
    if [ ! -f "${HOME}/.pki/nssdb/cert9.db" ]; then
      mkdir -p "${HOME}/.pki/nssdb"
      certutil -N -d "sql:${HOME}/.pki/nssdb" --empty-password
      echo "   Created ${HOME}/.pki/nssdb"
    fi
    while read -r db; do
      [ -n "${db}" ] || continue
      nss_purge_ca "${db}" >/dev/null   # drop stale entries from earlier CAs
      if certutil -A -n 'LocalLab-CA' -t 'CT,,' -i "${CA_CERT}" -d "sql:${db}" -f /dev/null 2>/dev/null; then
        echo "   Done: ${db}"
      else
        echo "   FAILED (db locked or password-protected): ${db}"
      fi
    done < <(chromium_nss_dbs)
    echo "   Restart Chrome to apply."

    echo ">> Installing CA into Firefox NSS databases..."
    found=0
    while read -r db; do
      [ -n "${db}" ] || continue
      found=1
      nss_purge_ca "${db}" >/dev/null   # drop stale entries from earlier CAs
      if certutil -A -n 'LocalLab-CA' -t 'CT,,' -i "${CA_CERT}" -d "sql:${db}" -f /dev/null 2>/dev/null; then
        echo "   Done: ${db}"
      else
        echo "   FAILED (db locked or password-protected): ${db}"
      fi
    done < <(firefox_nss_dbs)
    if [ "${found}" -eq 0 ]; then
      echo "   No Firefox profile found. Launch Firefox once to create one, then re-run."
    fi
    echo "   Restart Firefox to apply."

    warn_if_browser_running
    ;;

  --ca-only)
    generate_ca
    ;;

  "")
    # No args: generate CA + default wildcard certs
    if [ ! -f "${CA_KEY}" ] || [ ! -f "${CA_CERT}" ]; then
      generate_ca
    else
      echo ">> CA already exists at ${CA_CERT} (delete to regenerate)"
    fi
    echo ""
    generate_cert "${WILDCARD_DOMAIN}" "*.${WILDCARD_DOMAIN}"
    generate_cert "${K3S_WILDCARD_DOMAIN}" "*.${K3S_WILDCARD_DOMAIN}"
    # Guarded expansion so emptying the list stays safe under 'set -u'
    for extra_domain in ${EXTRA_WILDCARD_DOMAINS[@]+"${EXTRA_WILDCARD_DOMAINS[@]}"}; do
      generate_cert "${extra_domain}" "*.${extra_domain}"
    done
    echo "All done. Import the CA once to silence browser warnings:"
    echo "  gentls --install-ca"
    ;;

  *)
    # Custom domains passed as arguments
    if [ ! -f "${CA_KEY}" ] || [ ! -f "${CA_CERT}" ]; then
      generate_ca
    fi
    generate_cert "$@"
    echo "Import the CA if you haven't yet:"
    echo "  gentls --install-ca"
    ;;

esac
